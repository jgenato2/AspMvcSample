@model AspMvcSample.Application.DTOs.AttendanceDto
@{
    ViewBag.Title = "Record Attendance";
}
<h2>Record Attendance</h2>
<form asp-action="Create" method="post">
    <div class="form-group">
        <label asp-for="EmployeeId"></label>
        <input asp-for="EmployeeId" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Date"></label>
        <input asp-for="Date" class="form-control" type="date" />
    </div>
    <div class="form-group">
        <label asp-for="Present"></label>
        <input asp-for="Present" class="form-control" type="checkbox" />
    </div>
    <div class="form-group">
        <label asp-for="Remarks"></label>
        <input asp-for="Remarks" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Record</button>
</form>