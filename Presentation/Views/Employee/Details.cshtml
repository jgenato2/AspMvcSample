@model AspMvcSample.Application.DTOs.EmployeeDto
@{
    ViewBag.Title = "Employee Details";
}
<h2>Employee Details</h2>
<div>
    <strong>First Name:</strong> @Model.FirstName<br />
    <strong>Last Name:</strong> @Model.LastName<br />
    <strong>Email:</strong> @Model.Email<br />
    <strong>Department:</strong> @Model.DepartmentName<br />
    <strong>Position:</strong> @Model.PositionTitle<br />
    <strong>Company:</strong> @Model.CompanyName<br />
</div>
<a href="@Url.Action("Index")">Back to List</a>